{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jade",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jade",
      "database_id": "b807afc2-f47e-440c-9983-d3936641933b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jade-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "MemorialRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MemorialRoom"] }
  ],
  "routes": [
    {
      "pattern": "jade.fer.tec.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
